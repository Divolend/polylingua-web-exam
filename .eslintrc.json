{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 4],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "warn"
  },
  "globals": {
    "bootstrap": "readonly",
    "API": "readonly",
    "API_CONFIG": "readonly",
    "ENDPOINTS": "readonly",
    "buildUrl": "readonly",
    "showNotification": "readonly",
    "formatDate": "readonly",
    "formatDateForInput": "readonly",
    "formatTime": "readonly",
    "calculateEndTime": "readonly",
    "isWeekend": "readonly",
    "isMorningTime": "readonly",
    "isEveningTime": "readonly",
    "isEarlyRegistration": "readonly",
    "calculateCoursePrice": "readonly",
    "createPagination": "readonly",
    "truncateText": "readonly"
  }
}